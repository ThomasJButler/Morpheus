# Morpheus backend configuration.
#
# Nothing here is required. With no .env at all, Morpheus binds to
# 127.0.0.1:8000, talks only to Ollama on 127.0.0.1:11434, and keeps
# everything it stores under ./data. Unknown keys are ignored.
#
# Every line below is a default, commented out. Uncomment to change.

# --- Ollama ------------------------------------------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# The answer model. Install with: ollama pull qwen3.5:9b  (~6.6 GB)
# OLLAMA_CHAT_MODEL=qwen3.5:9b
# The embedding model. Install with: ollama pull nomic-embed-text (~274 MB)
# Changing it later means re-indexing your documents; the store refuses to mix.
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_CONNECT_TIMEOUT_S=3.0
# OLLAMA_READ_TIMEOUT_S=180.0
# OLLAMA_KEEP_ALIVE=15m
# OLLAMA_EMBED_BATCH_SIZE=32

# --- Storage -----------------------------------------------------------
# Everything Morpheus keeps (index, upload temp files) lives here.
# DATA_DIR=data

# --- Upload limits -----------------------------------------------------
# MAX_UPLOAD_MB=25
# MAX_PDF_PAGES=500
# MAX_TEXT_CHARS=2000000

# --- Chunking and retrieval --------------------------------------------
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=6
# CANDIDATES=20
# MIN_VECTOR_SCORE=0.5
# DEEP_MAX_SUBQUERIES=3

# --- Generation --------------------------------------------------------
# TEMPERATURE=0.2
# NUM_CTX=8192
# MAX_ANSWER_TOKENS=1024

# --- HTTP --------------------------------------------------------------
# Loopback by default. There is no authentication: exposing this beyond
# 127.0.0.1 is an explicit decision, see DEPLOYMENT.md.
# API_HOST=127.0.0.1
# API_PORT=8000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# RATE_LIMIT=60/minute
# LOG_LEVEL=INFO
