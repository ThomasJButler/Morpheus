# Morpheus frontend, development image with hot-reload. Used by
# docker-compose.yml; the port is published on 127.0.0.1 there.

FROM node:20-alpine

# Set working directory
WORKDIR /app

# Install dependencies for hot-reload
RUN apk add --no-cache \
    libc6-compat

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy application code
COPY . .

# Expose port
EXPOSE 3000

# Start development server with hot-reload
CMD ["npm", "run", "dev"]
