# Morpheus frontend configuration.
#
# Nothing here is required. With no .env.local at all, the app expects the
# backend on http://127.0.0.1:8000, which is where `uvicorn app.main:app`
# puts it. There are no API keys; the models run in Ollama on your machine.

# Where the browser reaches the backend.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Where the Next.js dev server proxies /api/health (same value, server-side).
# BACKEND_URL=http://127.0.0.1:8000

# Matrix rain background animation.
# NEXT_PUBLIC_ENABLE_MATRIX_RAIN=true

# Set to false to fall back to the legacy single-column layout.
# NEXT_PUBLIC_REDESIGN_V2=true
